+
+// Types de questions proposés (même liste que le serveur)
+const TYPES = [
+  ["single", "Choix unique"], ["multi", "Choix multiples"], ["yesno", "Oui / Non"],
+  ["rating", "Note de 1 à 5"], ["nps", "Recommandation (0 à 10)"], ["text", "Réponse libre"],
+];
