     out.sort(key=lambda f: f.get("last_modified") or "", reverse=True)
     return out[:MAX_SEARCH_RESULTS]
 
@@ -291,7 +430,10 @@ async def suggest_tags(db, *, code: str, key: str, data: bytes, content_type: st
