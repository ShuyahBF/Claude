         out.append({"key": o["key"], "name": parts["name"], "folder": parts["folder"],
-                    "size": o.get("size"), "last_modified": o.get("last_modified"), **public_meta(doc)})
+                    "size": o.get("size"), "last_modified": o.get("last_modified"), **public_meta(doc),
