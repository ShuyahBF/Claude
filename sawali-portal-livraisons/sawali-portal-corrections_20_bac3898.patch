Dans l'Explorateur Stockage R2 de Gestion de Stocks :
- un fil d'Ariane « Compartiment <bucket> › <client> › <dossier> » indique
  toujours d'où vient le contenu affiché ; le compartiment et le client
  sont cliquables pour revenir aux dossiers. Le nom du compartiment vient
  du serveur (/gestion-stocks/context renvoie bucket et max_upload_mb).
- dépôt depuis l'ordinateur, réservé au rôle admin comme la route serveur :
  bouton « Déposer des fichiers » bien visible, glisser-déposer, plusieurs
  fichiers à la fois envoyés un par un avec leur progression ; un fichier
  au-delà de la taille maximale est refusé avant l'envoi.
---
 backend/routes/gestion_stocks.py            |   6 +-
 frontend/src/pages/portal/GestionStocks.jsx | 175 +++++++++++++++++---
 2 files changed, 154 insertions(+), 27 deletions(-)

diff --git a/backend/routes/gestion_stocks.py b/backend/routes/gestion_stocks.py
index 2b1ef37..b707b93 100644
--- a/backend/routes/gestion_stocks.py
+++ b/backend/routes/gestion_stocks.py
@@ -370,7 +370,7 @@ def attach_gestion_stocks_routes(*, api, db, get_current_user, get_current_admin
         frontend s'en sert pour savoir quoi afficher avant tout listing."""
         if not _can_access_own_stocks(user):
             raise HTTPException(status_code=403, detail="Accès réservé aux comptes Pharmacien suivis (et admin/superviseur).")
-        from r2_stocks_client import is_configured
+        from r2_stocks_client import _bucket, is_configured
         client_code = None
         if (user.get("role") or "") in ("admin", "superviseur"):
             client_code = None  # l'admin choisit un client_code explicitement (voir endpoints /admin/*)
@@ -380,6 +380,10 @@ def attach_gestion_stocks_routes(*, api, db, get_current_user, get_current_admin
             "client_code": client_code,
             "folders": DEFAULT_FOLDERS,
             "r2_configured": is_configured(),
+            # Lot 20 — nom du compartiment R2 affiché dans le fil d'Ariane de
+            # l'explorateur (information non sensible : ni clé ni compte).
+            "bucket": _bucket() if is_configured() else None,
+            "max_upload_mb": MAX_UPLOAD_BYTES // (1024 * 1024),
             "is_admin": (user.get("role") or "") in ("admin", "superviseur"),
         }
 
