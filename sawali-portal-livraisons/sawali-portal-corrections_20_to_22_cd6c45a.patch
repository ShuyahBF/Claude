+    real = importlib.import_module("r2_stocks_client")
+    monkeypatch.delenv("R2_STOCKS_BUCKET", raising=False)
+    assert real._bucket() == "gestionstocks"
+    monkeypatch.setenv("R2_STOCKS_BUCKET", "autre")
+    assert real._bucket() == "autre"
