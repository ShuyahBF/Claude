+const fmt = (iso) => (iso ? new Date(iso).toLocaleString("fr-FR", { dateStyle: "short", timeStyle: "short" }) : "—");
+
+// Graphique d'une question selon son type
+function QuestionChart({ q, index }) {
+  if (q.type === "text") {
