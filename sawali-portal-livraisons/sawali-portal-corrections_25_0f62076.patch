+def test_can_blacklist_other_ip(env):
+    ns = _server_ns(env.db)
+    doc = env.run(ns["admin_add_blacklist"](types.SimpleNamespace(cidr="5.5.5.5", reason="spam"), _request("41.207.1.10"), _={}))
