+    for cidr in ("41.207.1.10", "41.207.1.0/24"):
+        with pytest.raises(_HTTPException) as exc:
+            env.run(ns["admin_add_blacklist"](types.SimpleNamespace(cidr=cidr, reason=""), _request("41.207.1.10"), _={}))
