@@ -48,7 +48,9 @@ def _get_client():
 
 
 def _bucket() -> str:
-    return (os.environ.get("R2_STOCKS_BUCKET") or "gestion-stocks").strip()
+    # Lot 20 — nom par défaut aligné sur le compartiment réel « gestionstocks »
