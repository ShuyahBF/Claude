<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions (lot 16 « Play Store ») : uniquement des permissions « normales »,
         accordées à l'installation, sans aucune demande à l'utilisateur.
         Plus de CALL_PHONE : l'app ouvre seulement le composeur (ACTION_DIAL), c'est
         l'utilisateur qui appuie lui-même sur « Appeler ». -->

    <!-- Nécessaire pour appeler l'API backend -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Permet de savoir si une connexion est disponible avant de tenter une synchro
         (voir util/ConnectivityUtils.kt) : ne demande aucune autorisation à l'utilisateur. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Ajoutée automatiquement par WorkManager mais inutile ici (aucune tâche au premier plan) :
         retirée du manifeste final pour garder la liste des permissions minimale. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />

    <!-- Android 11+ : déclare qu'on ouvre le composeur et le navigateur (sinon la vérification
         « une application peut-elle traiter ce lien ? » répondrait toujours non). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!-- Icône adaptative (lot 16) : mipmap-anydpi-v26/ic_launcher*.xml (Android 8+),
         mipmap/ic_launcher*.xml pour Android 7. -->
    <application
        android:name=".MobilePayApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.MobilePayments">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MobilePayments">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
