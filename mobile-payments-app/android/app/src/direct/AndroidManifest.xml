<?xml version="1.0" encoding="utf-8"?>
<!-- Version « direct » : manifeste ajouté à celui de l'application, UNIQUEMENT pour cette version (APK installé à la main, jamais publié sur le Play Store).
     La version « standard » (Play Store) n'a aucune de ces trois autorisations sensibles. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Envoyer le code USSD sans ouvrir le composeur (paiement direct) -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Retrouver la carte SIM de l'opérateur choisi (téléphone à deux cartes) -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Lire les SMS de paiement dans la boîte de réception (jamais envoyés ailleurs) -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <application>
        <!-- Service d'accessibilité : tape le code secret dans la fenêtre de l'opérateur pendant un paiement validé (à activer une fois dans Réglages → Accessibilité) -->
        <service
            android:name="com.ouoba.mobilepay.util.ServiceSaisieUssd"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/service_saisie_ussd" />
        </service>
        <!-- Écoute des notifications de paiement (SMS d'opérateur…), même application fermée : à activer une fois dans Réglages → Notifications → Accès aux notifications -->
        <service
            android:name="com.ouoba.mobilepay.util.EcouteNotificationsPaiement"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
