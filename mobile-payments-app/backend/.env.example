# URL de connexion MongoDB (Atlas ou instance locale)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mobile_payments?retryWrites=true&w=majority

# Port d'écoute de l'API
PORT=3000

# Clé optionnelle attendue dans l'en-tête "x-api-key" pour protéger les routes d'écriture (POST/PUT/DELETE).
# Laisser vide en développement.
API_KEY=
