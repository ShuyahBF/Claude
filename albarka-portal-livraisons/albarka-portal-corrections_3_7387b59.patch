+  if (value?.file_id) {
+    return (
+      <div className="flex items-center gap-2 text-sm text-emerald-700">
+        ✔ Signature enregistrée
+        {!disabled && <button type="button" onClick={() => onUpload(null)} className="text-xs text-slate-500 underline">Signer à nouveau</button>}
+      </div>
+    );
+  }
+  return (
