+                  {rows.length > 1 && !disabled && <button type="button" onClick={() => onChange(rows.filter((_, j) => j !== i))} className="text-slate-400 hover:text-rose-600"><Trash2 className="h-4 w-4" /></button>}
+                </td>
+              </tr>
+            ))}
+          </tbody>
+        </table>
+        {!disabled && <button type="button" onClick={() => onChange([...rows, {}])} className="mt-1 inline-flex items-center gap-1 text-xs text-primary"><Plus className="h-3 w-3" /> Ajouter une ligne</button>}
+      </div>
+    );
