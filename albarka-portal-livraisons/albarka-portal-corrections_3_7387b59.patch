+
+const COLORS = ["#0F6B4A", "#2563eb", "#7c3aed", "#db2777", "#ea580c", "#ca8a04", "#0891b2", "#475569"];
+
+function CategoriesManager({ apiBase, categories, onClose, onChanged }) {
