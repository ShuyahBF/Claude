+                      <button type="button" onClick={() => navigate(`${basePath}/${f.id}?tab=responses`)} className="inline-flex items-center gap-1 rounded-lg border px-2 py-1 text-xs"><Inbox className="h-3.5 w-3.5" /> Réponses</button>
