+    "form": {"id": "u-form", "full_name": "Awa Formulaires", "roles": ["comptable", "formulaires"], "is_active": True},
+    "sup": {"id": "u-sup", "full_name": "Superviseur", "roles": ["superviseur"], "is_active": True},
