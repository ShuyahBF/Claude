+            t[k] += float(r.get(k) or 0)
+        for x in r.get("employer_charges") or []:
+            employer_detail[x["label"]] = employer_detail.get(x["label"], 0) + float(x["amount"] or 0)
+    t["count"] = len(items)
+    t["employer_detail"] = [{"label": k, "amount": v} for k, v in employer_detail.items()]
+    return t
