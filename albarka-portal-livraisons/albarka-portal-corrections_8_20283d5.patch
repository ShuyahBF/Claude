+def _totals(items: List[dict]) -> dict:
+    t = {k: 0.0 for k, _ in LEDGER_COLUMNS}
+    t["iuts_base"] = 0.0
+    employer_detail: Dict[str, float] = {}
+    for b in items:
+        r = b.get("result") or {}
