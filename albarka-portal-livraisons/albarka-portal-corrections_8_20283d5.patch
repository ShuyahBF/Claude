+const openPdf = async (url, params) => {
+  try {
+    const { data } = await apiClient.get(url, { params, responseType: "blob" });
+    window.open(URL.createObjectURL(data), "_blank");
+  } catch (e) { toast.error(extractError(e)); }
+};
