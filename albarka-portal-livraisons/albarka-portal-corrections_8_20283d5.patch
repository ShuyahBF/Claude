+          <tbody>
+            {/* Même ordre que le PDF : gains, brut, CNSS et IUTS, net, puis soutien patriotique et retenues */}
+            {(() => {
+              const isAfter = (ln) => ln.code === "patriotic" || ln.code.startsWith("ded_");
+              const row = (ln, i) => (
