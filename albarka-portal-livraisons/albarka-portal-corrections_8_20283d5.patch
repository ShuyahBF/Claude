+              {data.items.length > 0 && (
+                <tr className="border-t-2 font-semibold bg-slate-50"><td className="px-3 py-2">TOTAL ({t.count})</td><td className="text-right">{fcfa(t.gross)}</td><td className="text-right">{fcfa(t.cnss)}</td>
