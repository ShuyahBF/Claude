+
+SANDRINE = {"base_salary": 231672, "allowances": {"housing": 50000, "transport": 30000, "function": 30000}, "dependents": 1}
+EXACT = {"rounding": {"amounts": {"step": 0}, "iuts_base": {"step": 1, "mode": "down"}, "net": {"step": 0}}}
