+                <tr><th className="px-3 py-2 text-left">Salarié</th>{data.columns.map((c) => <th key={c.key} className="text-right px-2">{c.label}</th>)}</tr>
+              </thead>
+              <tbody>
+                {data.rows.map((r) => (
