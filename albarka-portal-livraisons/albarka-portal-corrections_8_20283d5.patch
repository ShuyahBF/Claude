+        </div>
+      ))}
+      {!disabled && <button type="button" onClick={() => onChange([...items, { label: "", amount: "" }])} className="inline-flex items-center gap-1 text-xs font-medium" style={{ color: GREEN }}><Plus className="h-3 w-3" /> Ajouter</button>}
+    </div>
