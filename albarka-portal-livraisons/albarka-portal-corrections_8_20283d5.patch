+    t = Table(rows, colWidths=[8 * mm, 48 * mm, 36 * mm] + [23.3 * mm] * len(LEDGER_COLUMNS), repeatRows=1)
+    t.setStyle(TableStyle([("BACKGROUND", (0, 0), (-1, 0), green), ("TEXTCOLOR", (0, 0), (-1, 0), colors.white),
