+@router.post("/preview")
+async def preview(payload: Dict[str, Any] = Body(...), user: dict = Depends(require_roles(CLIENT_SPACE_ROLES))):
+    """Aperçu d'un texte de notification avec des valeurs d'exemple (Paramètres)."""
