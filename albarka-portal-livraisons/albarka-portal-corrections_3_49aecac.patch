+
+      {tab === "settings" ? (
+        <SettingsTab settings={draft.settings} set={(p) => change({ settings: { ...(draft.settings || {}), ...p } })} />
+      ) : (
+        <div className="grid grid-cols-1 lg:grid-cols-[190px_1fr_280px] gap-4">
+          {/* Palette */}
+          <div className="space-y-1" data-testid="builder-palette">
