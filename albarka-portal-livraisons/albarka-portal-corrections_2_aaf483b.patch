-def _clamp_confidence(value: Any) -> Optional[float]:
-    """Ramène la confiance auto-déclarée dans [0, 1] (None si absente/illisible)."""
-    try:
-        return max(0.0, min(1.0, float(value)))
-    except (TypeError, ValueError):
-        return None
