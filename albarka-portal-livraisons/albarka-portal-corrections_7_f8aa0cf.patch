+def used_variables(body: str) -> List[str]:
+    """Variables présentes dans le texte, dans l'ordre d'apparition."""
+    seen: List[str] = []
+    for key in _VAR_RE.findall(body or ""):
+        if key not in seen:
+            seen.append(key)
+    return seen
