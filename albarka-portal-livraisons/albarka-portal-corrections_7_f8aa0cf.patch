+    const row = `<tr>${Array.from({ length: c }, () => `<td style="${cellStyle}">&nbsp;</td>`).join("")}</tr>`;
+    insertNodes(`<table border="1" style="border-collapse: collapse; width: 100%;"><tbody>${row.repeat(r)}</tbody></table><p><br></p>`);
+    setTableDlg(false);
+  };
+  const tableOp = (op) => {
+    restoreRange();
+    const cell = currentCell();
+    if (!cell) return;
