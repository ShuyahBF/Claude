+                    <button type="button" onClick={() => openServerFile(`/letters/documents/${d.id}/word`, { download: true, filename: `${(d.number || "document").replace(/\//g, "-")}.doc` })} className={ui.act.sky}><Download className="h-3.5 w-3.5" /> Word</button>
