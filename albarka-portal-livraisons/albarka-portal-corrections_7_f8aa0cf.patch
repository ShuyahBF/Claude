+def _pdf_text(data: bytes) -> str:
+    with fitz.open("pdf", data) as d:
+        text = "\n".join(p.get_text() for p in d)
+    # Espaces et retours à la ligne normalisés (le PDF coupe les lignes longues)
+    return " ".join(text.split())
