+
+def test_staff_upload_rejects_unknown_model(api):
+    res = _upload(api, kind="piece_comptable", tenant_id="tests-ocr", model="gpt-4o")
+    assert res.status_code == 400
+
+
+def test_client_cannot_choose_model(api):
+    api.state["user"] = CLIENT
+    res = _upload(api, kind="piece_comptable", model="claude-haiku-4-5-20251001")
+    assert res.status_code == 200
+    assert api.scheduled[-1][5] == albarka_ai.DEFAULT_MODEL_ID
