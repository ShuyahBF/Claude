+    assert api.client.get("/api/documents/ocr-models").status_code == 403
+
+
+def test_full_cycle_analyze_review_stats(api, monkeypatch):
+    # 1. Dépôt par le staff pour un client
+    res = _upload(api, kind="piece_comptable", tenant_id=CLIENT["id"], model="claude-opus-5")
+    doc_id = res.json()["id"]
+
+    # 2. Exécution réelle de _analyze_and_store (appel IA simulé)
+    fake = {
+        "document_type": "Facture", "summary": "ok", "flags": [], "confidence": 0.9,
+        "uncertain_fields": [], "extracted_fields": {"numero": "F-1", "montant_total": 1000},
+        "model": "claude-opus-5", "input_tokens": 3000, "output_tokens": 600,
+        "cost_usd": 0.03, "cost_xof": 18.0, "pages_analyzed": 1, "duration_ms": 1500,
+    }
+    monkeypatch.setattr(albarka_documents, "extract_and_synthesize", lambda *a: dict(fake))
+    asyncio.run(_ORIGINAL_ANALYZE(doc_id, b"x", "image/png", "facture.png", CLIENT["id"], "claude-opus-5", STAFF["id"]))
+    fake2 = dict(fake, model="claude-haiku-4-5-20251001", cost_xof=3.0, extracted_fields={"numero": "F-7", "montant_total": 1000})
+    monkeypatch.setattr(albarka_documents, "extract_and_synthesize", lambda *a: dict(fake2))
+    asyncio.run(_ORIGINAL_ANALYZE(doc_id, b"x", "image/png", "facture.png", CLIENT["id"], "claude-haiku-4-5-20251001", STAFF["id"]))
+
+    # 3. Le staff voit les 2 exécutions ; le client uniquement la dernière, sans coût
+    staff_view = api.client.get(f"/api/documents/{doc_id}").json()
+    assert [s["model"] for s in staff_view["syntheses"]] == ["claude-opus-5", "claude-haiku-4-5-20251001"]
+    assert staff_view["status"] == "analyse"
+    listing = api.client.get("/api/documents").json()
+    assert [r["model"] for r in listing[0]["runs"]] == ["claude-opus-5", "claude-haiku-4-5-20251001"]
+
+    api.state["user"] = CLIENT
+    client_view = api.client.get(f"/api/documents/{doc_id}").json()
+    assert "syntheses" not in client_view
+    assert "cost_xof" not in client_view["synthesis"] and "model" not in client_view["synthesis"]
+    assert "runs" not in api.client.get("/api/documents").json()[0]
+    api.state["user"] = STAFF
+
+    # 4. Évaluation : étoiles hors bornes refusées, puis évaluation valide
+    haiku_run = staff_view["syntheses"][1]["id"]
+    opus_run = staff_view["syntheses"][0]["id"]
+    bad = api.client.post(f"/api/documents/syntheses/{haiku_run}/review", json={"rating": 6})
+    assert bad.status_code == 422
+    review = api.client.post(
+        f"/api/documents/syntheses/{haiku_run}/review",
+        json={"rating": 2, "comment": "numéro faux", "corrected_fields": {"numero": "F-1", "montant_total": "1 000"}},
+    ).json()
+    assert review["accuracy"] == pytest.approx(0.5) and review["corrected_fields"] == {"numero": "F-1"}
+    api.client.post(f"/api/documents/syntheses/{opus_run}/review", json={"rating": 5, "corrected_fields": {}})
+
+    # 5. Tableau de bord par modèle
+    stats = api.client.get("/api/documents/ocr-stats?period=today").json()
+    by_model = {m["model"]: m for m in stats["models"]}
+    assert by_model["claude-opus-5"]["avg_rating"] == 5 and by_model["claude-opus-5"]["avg_accuracy"] == 1
+    assert by_model["claude-haiku-4-5-20251001"]["avg_rating"] == 2
+    assert stats["total"]["runs"] == 2 and stats["total"]["total_cost_xof"] == pytest.approx(21.0)
+    assert api.client.get("/api/documents/ocr-stats?period=hier").status_code == 400
+
+
+def test_reanalyze_schedules_new_run_with_other_model(api):
