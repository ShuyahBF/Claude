+def _upload(api, **form):
+    files = {"file": ("facture.png", _png(200, 100), "image/png")}
+    return api.client.post("/api/documents", files=files, data=form)
+
+
+def test_staff_upload_with_chosen_model(api):
+    res = _upload(api, kind="piece_comptable", tenant_id="tests-ocr", model="claude-haiku-4-5-20251001")
+    assert res.status_code == 200, res.text
+    args = api.scheduled[-1]
+    assert args[4] == "tests-ocr" and args[5] == "claude-haiku-4-5-20251001"
