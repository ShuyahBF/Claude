+from __future__ import annotations
+
+import asyncio
+import io
+import json
+import os
+from types import SimpleNamespace
+
+# db.py et albarka_auth.py lisent ces variables dès l'import.
+os.environ.setdefault("MONGO_URL", "mongodb://localhost:27017")
+os.environ.setdefault("DB_NAME", "albarka_test")
+os.environ.setdefault("JWT_SECRET_KEY", "test-secret")
+os.environ.setdefault("USD_TO_XOF_RATE", "600")
+
+import pytest
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+from mongomock_motor import AsyncMongoMockClient
+from PIL import Image
+
+import albarka_ai
+import albarka_documents
+from albarka_auth import get_current_user
+
+STAFF = {"id": "staff-1", "full_name": "Comptable Test", "roles": ["comptable"], "is_active": True}
+CLIENT = {"id": "client-1", "full_name": "Client Test", "roles": ["client"], "is_active": True}
+
+
+# ---------------------------------------------------------------------
+# Fabriques de fichiers de test
+# ---------------------------------------------------------------------
+def _png(width: int, height: int) -> bytes:
+    buf = io.BytesIO()
+    Image.new("RGB", (width, height), "white").save(buf, format="PNG")
+    return buf.getvalue()
+
+
+def _pdf(pages: int) -> bytes:
+    import fitz
+
+    doc = fitz.open()
+    for i in range(pages):
+        doc.new_page().insert_text((72, 72), f"Facture page {i + 1}")
+    data = doc.tobytes()
+    doc.close()
+    return data
+
+
+# ---------------------------------------------------------------------
+# albarka_ai : coût, préparation des images, lecture de la réponse
+# ---------------------------------------------------------------------
+def test_compute_cost_uses_real_tokens_and_rate():
+    opus = albarka_ai.OCR_MODELS["claude-opus-5"]
+    usd, xof = albarka_ai.compute_cost(opus, 1000, 500)
+    assert usd == pytest.approx(0.0175)          # 1000×5$/M + 500×25$/M
+    assert xof == pytest.approx(10.5)            # × 600 FCFA/USD
+
+
+def test_prepare_images_shrinks_large_photo():
+    images, notes = albarka_ai.prepare_images(_png(4000, 3000), "image/png")
+    assert len(images) == 1 and notes == []
+    with Image.open(io.BytesIO(images[0])) as img:
+        assert img.format == "JPEG"
+        assert max(img.size) == albarka_ai.MAX_IMAGE_EDGE_PX
+
+
+def test_prepare_images_pdf_pages_are_capped_and_flagged():
+    images, notes = albarka_ai.prepare_images(_pdf(12), "application/pdf")
+    assert len(images) == albarka_ai.MAX_PDF_PAGES
+    assert notes and "12" in notes[0]
+
+
+def test_prepare_images_rejects_office_files():
+    with pytest.raises(ValueError):
+        albarka_ai.prepare_images(b"PK...", "application/vnd.openxmlformats-officedocument.wordprocessingml.document")
+
+
+def test_extract_parses_json_and_computes_cost(monkeypatch):
+    answer = {
+        "document_type": "Facture",
+        "summary": "Facture de réparation moto.",
+        "extracted_fields": {"numero": "F-12", "montant_total": 150000},
+        "flags": [],
+        "confidence": 1.7,                       # hors bornes → ramené à 1
+        "uncertain_fields": ["numero", 3],       # valeur non texte ignorée
+    }
+    monkeypatch.setattr(albarka_ai, "_call_llm", lambda model, images, fn: (json.dumps(answer), 2000, 400))
+    result = albarka_ai.extract_and_synthesize(_png(800, 600), "image/png", "f.png", "claude-sonnet-5")
+    assert result["model"] == "claude-sonnet-5"
+    assert result["extracted_fields"]["montant_total"] == 150000
+    assert result["confidence"] == 1.0
+    assert result["uncertain_fields"] == ["numero"]
+    assert result["cost_usd"] == pytest.approx(0.008)   # 2000×2$/M + 400×10$/M
+    assert result["cost_xof"] == pytest.approx(4.8)
+    assert "error" not in result
+
+
+def test_extract_keeps_cost_when_answer_is_not_json(monkeypatch):
+    monkeypatch.setattr(albarka_ai, "_call_llm", lambda model, images, fn: ("désolé", 1000, 10))
+    result = albarka_ai.extract_and_synthesize(_png(100, 100), "image/png", "f.png", "claude-haiku-4-5-20251001")
+    assert result["error"]
+    assert result["cost_xof"] > 0                       # tokens consommés = coût réel comptabilisé
+
+
+def test_extract_unknown_model_falls_back_to_default(monkeypatch):
+    monkeypatch.setattr(albarka_ai, "_call_llm", lambda model, images, fn: ('{"summary": "ok"}', 10, 10))
+    result = albarka_ai.extract_and_synthesize(_png(100, 100), "image/png", "f.png", "gpt-inconnu")
+    assert result["model"] == albarka_ai.DEFAULT_MODEL_ID
+
+
+def test_call_llm_reads_real_usage_from_proxy(monkeypatch):
+    """Vérifie le branchement réel sur emergentintegrations : modèle transmis,
+    images en image_url, et tokens lus dans usage (pas estimés)."""
+    from emergentintegrations.llm.chat import LlmChat
+
+    captured = {}
+
+    async def fake_execute(self, messages):
+        captured["model"] = self.model
+        captured["provider"] = self.provider
+        captured["params"] = self.extra_params
+        captured["messages"] = messages
+        return SimpleNamespace(
+            choices=[SimpleNamespace(message=SimpleNamespace(content='{"summary": "x"}'))],
+            usage=SimpleNamespace(prompt_tokens=1234, completion_tokens=56),
+        )
+
+    monkeypatch.setenv("EMERGENT_LLM_KEY", "sk-emergent-test")
+    monkeypatch.setattr(LlmChat, "_execute_completion", fake_execute)
+    text, tin, tout = albarka_ai._call_llm(albarka_ai.OCR_MODELS["claude-opus-5"], [b"img1", b"img2"], "f.pdf")
+    assert (text, tin, tout) == ('{"summary": "x"}', 1234, 56)
+    assert captured["provider"] == "anthropic" and captured["model"] == "claude-opus-5"
+    assert captured["params"]["max_tokens"] == 8192
+    user_content = captured["messages"][1]["content"]
+    assert [p["type"] for p in user_content] == ["image_url", "image_url", "text"]
+
+
+def test_call_llm_without_key_is_reported(monkeypatch):
+    monkeypatch.delenv("EMERGENT_LLM_KEY", raising=False)
+    result = albarka_ai.extract_and_synthesize(_png(100, 100), "image/png", "f.png", "claude-opus-5")
+    assert "EMERGENT_LLM_KEY" in result["flags"][0]
+
+
+# ---------------------------------------------------------------------
+# Précision réelle (corrections humaines)
+# ---------------------------------------------------------------------
+def test_compute_accuracy_ignores_formatting_differences():
+    extracted = {"numero": "F-12", "montant_total": 150000, "date": "2026-09-01", "client": "SARL X"}
+    corrected = {
+        "numero": " f-12 ",              # casse/espaces → pas une correction
+        "montant_total": "150 000",      # format du nombre → pas une correction
+        "date": "2026-09-02",            # vraie correction
+        "ifu": "00012345A",              # champ oublié par le modèle → erreur
+    }
+    acc = albarka_documents.compute_accuracy(extracted, corrected)
+    assert acc["fields_total"] == 5
+    assert acc["fields_corrected"] == 2
+    assert set(acc["changed"]) == {"date", "ifu"}
+    assert acc["accuracy"] == pytest.approx(0.6)
+
+
+def test_compute_accuracy_no_fields():
+    assert albarka_documents.compute_accuracy({}, {})["accuracy"] is None
+
+
+# ---------------------------------------------------------------------
+# API (FastAPI + Mongo simulé)
+# ---------------------------------------------------------------------
+@pytest.fixture()
+def api(monkeypatch):
+    mock_db = AsyncMongoMockClient()["albarka_test"]
+    monkeypatch.setattr(albarka_documents, "db", mock_db)
+
+    stored = {}
+
+    async def fake_save_and_log(db, *, data, kind, tenant_id, ext, content_type=None, original_filename=None, user_id=None, metadata=None):
+        path = f"{kind}/{tenant_id}/{original_filename}"
+        stored[path] = data
+        return {"id": f"doc-{len(stored)}", "path": path, "size": len(data), "content_type": content_type}
+
+    async def fake_get_object(path):
+        return stored[path], "image/png"
+
+    monkeypatch.setattr(albarka_documents.storage_r2, "save_and_log", fake_save_and_log)
+    monkeypatch.setattr(albarka_documents.storage_r2, "get_object", fake_get_object)
+
+    # L'analyse de fond est enregistrée au lieu d'être lancée : les tests
+    # l'exécutent explicitement pour rester déterministes.
+    scheduled = []
+
+    async def fake_analyze(*args):
+        scheduled.append(args)
+
+    monkeypatch.setattr(albarka_documents, "_analyze_and_store", fake_analyze)
+
+    app = FastAPI()
+    app.include_router(albarka_documents.router, prefix="/api")
+    state = {"user": STAFF}
+    app.dependency_overrides[get_current_user] = lambda: state["user"]
+    client = TestClient(app)
+    return SimpleNamespace(client=client, db=mock_db, scheduled=scheduled, state=state)
+
