+// Détail d'UNE exécution d'analyse (un modèle) + formulaire d'évaluation :
+// note de 1 à 5 étoiles, commentaire, et correction des champs extraits.
+// Le serveur compare les valeurs corrigées aux valeurs extraites pour
+// calculer la précision réelle (% de champs justes) — les différences de
+// simple mise en forme ("150 000" vs 150000) ne comptent pas comme erreurs.
+import { useEffect, useMemo, useState } from "react";
+import { Button } from "@/components/ui/button";
+import { Input } from "@/components/ui/input";
+import { Textarea } from "@/components/ui/textarea";
+import { Badge } from "@/components/ui/badge";
+import { toast } from "@/components/ui/sonner";
+import { apiClient } from "@/pilot/api";
+import StarRating from "@/pilot/ocr/StarRating";
+import { displayValue, formatDuration, formatPercent, formatXof, shortModel } from "@/pilot/ocr/format";
+
+// Valeur éditable (texte) d'un champ : les listes/objets passent en JSON.
+function toEditable(value) {
+  if (value === null || value === undefined) return "";
+  return typeof value === "object" ? JSON.stringify(value, null, 2) : String(value);
+}
+
+// Retransforme le texte saisi : JSON si c'en était (lignes de facture...),
+// sinon texte brut.
+function fromEditable(text, original) {
+  if (original !== null && typeof original === "object") {
+    try {
+      return JSON.parse(text);
+    } catch {
+      return text;
+    }
+  }
+  return text;
+}
+
+export default function OcrReviewPanel({ run, onReviewed }) {
+  const extracted = useMemo(() => run.extracted_fields || {}, [run]);
+  const uncertain = useMemo(() => new Set(run.uncertain_fields || []), [run]);
+  const review = run.review;
+
+  // Formulaire pré-rempli avec l'évaluation existante (si déjà notée).
+  const [rating, setRating] = useState(review?.rating || 0);
+  const [comment, setComment] = useState(review?.comment || "");
+  const [values, setValues] = useState({});
+  const [extraFields, setExtraFields] = useState([]); // champs oubliés par le modèle
+  const [saving, setSaving] = useState(false);
+
+  useEffect(() => {
+    const corrected = review?.corrected_fields || {};
+    const initial = {};
+    Object.entries(extracted).forEach(([key, value]) => {
+      initial[key] = toEditable(key in corrected ? corrected[key] : value);
+    });
+    setValues(initial);
+    setExtraFields(
+      Object.entries(corrected)
+        .filter(([key]) => !(key in extracted))
+        .map(([key, value]) => ({ key, value: toEditable(value) })),
+    );
+    setRating(review?.rating || 0);
+    setComment(review?.comment || "");
+  }, [run, extracted, review]);
+
+  const submit = async () => {
+    if (!rating) {
+      toast.error("Choisis une note de 1 à 5 étoiles");
+      return;
+    }
+    // On envoie TOUS les champs : le serveur ne retient que ceux qui ont
+    // réellement changé.
+    const corrected = {};
+    Object.entries(values).forEach(([key, text]) => {
+      corrected[key] = fromEditable(text, extracted[key]);
+    });
+    extraFields.forEach(({ key, value }) => {
+      if (key.trim()) corrected[key.trim()] = value;
+    });
+    setSaving(true);
+    try {
+      const { data } = await apiClient.post(`/documents/syntheses/${run.id}/review`, {
+        rating,
+        comment,
+        corrected_fields: corrected,
+      });
+      toast.success(`Évaluation enregistrée — précision réelle : ${formatPercent(data.accuracy)}`);
+      onReviewed?.();
+    } catch (err) {
+      toast.error(err?.response?.data?.detail || "Échec de l'enregistrement");
+    } finally {
+      setSaving(false);
+    }
+  };
+
+  return (
+    <div className="space-y-4">
+      {/* Métriques de l'exécution : modèle, coût réel, volume, durée */}
+      <div className="grid grid-cols-2 sm:grid-cols-4 gap-2 text-sm">
+        <Metric label="Modèle" value={shortModel(run.model)} />
+        <Metric label="Coût réel" value={formatXof(run.cost_xof)} />
+        <Metric label="Tokens (entrée / sortie)" value={`${run.input_tokens ?? 0} / ${run.output_tokens ?? 0}`} />
+        <Metric label="Durée" value={`${formatDuration(run.duration_ms)} · ${run.pages_analyzed || 0} p.`} />
+      </div>
+
+      {run.document_type_guess && (
+        <p className="text-sm"><span className="font-medium">Type détecté : </span>{run.document_type_guess}</p>
+      )}
+      {run.summary && <p className="text-sm text-slate-700 whitespace-pre-wrap">{run.summary}</p>}
+
+      <p className="text-xs text-muted-foreground">
+        Confiance déclarée par le modèle : {formatPercent(run.confidence)} — indicative seulement,
+        seule la relecture humaine ci-dessous mesure la précision réelle.
+      </p>
+
+      {run.flags?.length > 0 && (
+        <ul className="list-disc list-inside text-sm text-amber-700">
+          {run.flags.map((flag, i) => <li key={i}>{flag}</li>)}
+        </ul>
+      )}
+
+      {/* Champs extraits, corrigeables. Orange = champ jugé incertain par le modèle. */}
+      {Object.keys(extracted).length > 0 && (
+        <div className="space-y-2">
+          <p className="font-medium text-sm">Champs extraits (corrige ce qui est faux)</p>
+          {Object.entries(extracted).map(([key, original]) => {
+            const isObject = original !== null && typeof original === "object";
+            const changed = (values[key] ?? "") !== toEditable(original);
+            return (
+              <div key={key} className="grid grid-cols-1 sm:grid-cols-3 gap-1 sm:gap-3 items-start">
+                <label className={`text-sm pt-2 ${uncertain.has(key) ? "text-amber-700 font-medium" : "text-muted-foreground"}`}>
+                  {key}{uncertain.has(key) && " (incertain)"}
+                </label>
+                <div className="sm:col-span-2">
+                  {isObject ? (
+                    <Textarea
+                      rows={4}
+                      className={`font-mono text-xs ${changed ? "border-blue-500" : ""}`}
+                      value={values[key] ?? ""}
+                      onChange={(e) => setValues((v) => ({ ...v, [key]: e.target.value }))}
+                    />
+                  ) : (
+                    <Input
+                      className={`${uncertain.has(key) ? "bg-amber-50" : ""} ${changed ? "border-blue-500" : ""}`}
+                      value={values[key] ?? ""}
+                      onChange={(e) => setValues((v) => ({ ...v, [key]: e.target.value }))}
+                    />
+                  )}
+                  {changed && (
+                    <p className="text-xs text-muted-foreground mt-1 whitespace-pre-wrap">
+                      Extrait par l'IA : {displayValue(original)}
+                    </p>
+                  )}
+                </div>
+              </div>
+            );
+          })}
+        </div>
+      )}
+
+      {/* Champs que le modèle a oubliés : comptent comme erreurs */}
+      <div className="space-y-2">
+        {extraFields.map((field, i) => (
+          <div key={i} className="grid grid-cols-1 sm:grid-cols-3 gap-2">
+            <Input
+              placeholder="Nom du champ (ex. ifu)"
+              value={field.key}
+              onChange={(e) => setExtraFields((list) => list.map((f, j) => (j === i ? { ...f, key: e.target.value } : f)))}
+            />
+            <Input
+              className="sm:col-span-2"
+              placeholder="Valeur correcte"
+              value={field.value}
+              onChange={(e) => setExtraFields((list) => list.map((f, j) => (j === i ? { ...f, value: e.target.value } : f)))}
+            />
+          </div>
+        ))}
+        <Button type="button" variant="outline" size="sm"
+          onClick={() => setExtraFields((list) => [...list, { key: "", value: "" }])}>
+          + Champ oublié par l'IA
+        </Button>
+      </div>
+
+      {/* Note globale + commentaire */}
+      <div className="border-t pt-4 space-y-3">
+        <div className="flex items-center gap-3">
+          <span className="text-sm font-medium">Ta note :</span>
+          <StarRating value={rating} onChange={setRating} size={24} />
+          {review && (
+            <Badge variant="secondary">
+              Évaluée · précision {formatPercent(review.accuracy)} ({review.fields_corrected}/{review.fields_total} corrigés)
+            </Badge>
+          )}
+        </div>
+        <Textarea
+          rows={2}
+          placeholder="Commentaire (facultatif) : ce qui est faux, manuscrit mal lu, tampon..."
+          value={comment}
+          onChange={(e) => setComment(e.target.value)}
+        />
+        <Button onClick={submit} disabled={saving} data-testid="ocr-review-submit">
+          {saving ? "Enregistrement..." : review ? "Mettre à jour l'évaluation" : "Enregistrer l'évaluation"}
+        </Button>
+      </div>
+    </div>
+  );
+}
+
+function Metric({ label, value }) {
+  return (
+    <div className="rounded-md border bg-slate-50 px-3 py-2">
+      <p className="text-xs text-muted-foreground">{label}</p>
+      <p className="font-medium">{value}</p>
+    </div>
+  );
+}
