+def _normalize(value: Any) -> Any:
+    """Forme comparable d'une valeur : ignore les espaces, la casse et le
+    format des nombres ("150 000", "150000", 150000.0 sont égaux)."""
+    if value is None:
+        return ""
+    if isinstance(value, (dict, list)):
+        return json.dumps(value, sort_keys=True, ensure_ascii=False)
+    text = " ".join(str(value).split())
+    compact = text.replace(" ", "").replace(" ", "").replace(",", ".")
+    try:
+        return float(compact)
+    except ValueError:
+        return text.lower()
+
+
+def compute_accuracy(extracted: Dict[str, Any], corrected: Dict[str, Any]) -> Dict[str, Any]:
+    """Précision réelle = part des champs que le comptable n'a PAS eu à corriger.
+
+    Renvoie aussi le détail (champs réellement modifiés) pour l'historique."""
+    changed = {
+        key: value for key, value in corrected.items()
+        if key not in extracted or _normalize(value) != _normalize(extracted.get(key))
+    }
+    total = len(set(extracted) | set(corrected))
+    accuracy = round((total - len(changed)) / total, 4) if total else None
+    return {"changed": changed, "fields_total": total, "fields_corrected": len(changed), "accuracy": accuracy}
+
