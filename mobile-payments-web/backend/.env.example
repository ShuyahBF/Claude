# Copier en .env pour le développement local (jamais committé).
# Base en mémoire, vidée à chaque arrêt ; mettre l'adresse Atlas pour garder les données.
MONGO_URL=mongomock://
MONGO_DB_NAME=paiement_mobile
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173
# Secret de signature des sessions : une longue chaîne aléatoire en production
JWT_SECRET=a-changer
# Compte administrateur (gestion du catalogue USSD), créé au démarrage
ADMIN_EMAIL=admin@exemple.bf
ADMIN_PASSWORD=admin-a-changer
# Alerte WhatsApp de connexion via SAWALI (facultatif en local : vide = aucun signal)
LILUVINE_WA_HMAC=
LILUVINE_WA_EMETTEUR=paiementmobile
# Signal de présence auprès de SAWALI (0 = désactivé, conseillé en local)
PRESENCE_SAWALI=0
